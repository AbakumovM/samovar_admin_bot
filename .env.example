ANTIFRAUD_COOLDOWN_HOURS=24
ANTIFRAUD_JOB_POLL_INTERVAL_SECONDS=1.0
ANTIFRAUD_JOB_POLL_TIMEOUT_SECONDS=15.0
ANTIFRAUD_USER_CACHE_TTL_SECONDS=300.0
ANTIFRAUD_USER_RESOLVE_CONCURRENCY=8
