TELEGRAM_BOT_TOKEN=your_token_here
ADMIN_IDS=[123456789,987654321]
REMNAWAVE_BASE_URL=https://your-panel.com
REMNAWAVE_TOKEN=your_api_token_here
DATABASE_URL=postgresql+asyncpg://botuser:botpass@localhost:5432/botdb

POLL_INTERVAL_SECONDS=120
FAST_POLL_INTERVAL_SECONDS=30
ESCALATION_WINDOW_MINUTES=60
ESCALATION_MAX_ATTEMPTS=3
DAILY_REPORT_HOUR_UTC=17

TRAFFIC_CHECK_INTERVAL_SECONDS=3600
# JSON-массив, пороги алертов за скользящие 24ч
TRAFFIC_ALERT_THRESHOLDS_GB=[30,50,100,150]
TRAFFIC_CRITICAL_THRESHOLD_GB=150
TRAFFIC_ANOMALY_MULTIPLIER=2.0

BILLING_ALERT_DAYS_BEFORE=3
BILLING_CHECK_HOUR_UTC=17

ANTIFRAUD_ENABLED=false
ANTIFRAUD_SCAN_INTERVAL_SECONDS=1800
ANTIFRAUD_IP_SLACK=2
ANTIFRAUD_IP_SLACK_MULTIPLIER=0.0
ANTIFRAUD_IP_RECENCY_SECONDS=60
ANTIFRAUD_COOLDOWN_HOURS=24
ANTIFRAUD_JOB_POLL_INTERVAL_SECONDS=1.0
ANTIFRAUD_JOB_POLL_TIMEOUT_SECONDS=15.0
ANTIFRAUD_USER_CACHE_TTL_SECONDS=300.0
ANTIFRAUD_USER_RESOLVE_CONCURRENCY=8
# JSON-массивы (как ADMIN_IDS) — обязателен формат [..], не просто через запятую
ANTIFRAUD_IGNORED_NODE_UUIDS=[]
ANTIFRAUD_IP_WHITELIST=[]
ANTIFRAUD_WHITELIST_USER_IDS=[]
ANTIFRAUD_SOFT_ALERTS_ENABLED=false
ANTIFRAUD_VIOLATION_THRESHOLD=1
ANTIFRAUD_VIOLATION_WINDOW_SECONDS=3600
ANTIFRAUD_SUBNET_GROUPING=false
ANTIFRAUD_SUBNET_PREFIX_V4=24
ANTIFRAUD_ASN_GROUPING=false
ANTIFRAUD_MAXMIND_ACCOUNT_ID=
ANTIFRAUD_MAXMIND_LICENSE_KEY=
ANTIFRAUD_ASN_DATABASE_PATH=./geoip/GeoLite2-ASN.mmdb
ANTIFRAUD_MAXMIND_UPDATE_INTERVAL_HOURS=168
ANTIFRAUD_AUTO_BLOCK_ENABLED=false                 # Авто-блок при 2/2 критериях (много IP + нет оплаты), по умолчанию: false
SAMOVARBOT_BASE_URL=                                # Базовый URL сервиса подписок (samovarbot), напр. https://samovarpn.com
SAMOVARBOT_INTERNAL_API_KEY=                        # Ключ для internal API samovarbot (X-Internal-Api-Key)

# Проверка блокировок IP нод (ТСПУ) — см. CLAUDE.md, «Блокировки IP»
REACHABILITY_ENABLED=false
REACHABILITY_INTERVAL_SECONDS=600
REACHABILITY_JITTER_SECONDS=120
REACHABILITY_CONFIRM_PASSES=2
REACHABILITY_REMINDER_HOURS=6
REACHABILITY_TIMEOUT_SECONDS=5.0
REACHABILITY_POINT_TIMEOUT_SECONDS=30.0
REACHABILITY_CONTROL_TARGETS=["github.com","www.microsoft.com","www.apple.com","www.cloudflare.com"]
REACHABILITY_CONTROL_MIN_OK_RATIO=0.5
REACHABILITY_HOST_TAGS=["SELF","GEMINI","GAME","SMART","SMART_MAIN","EXIT","SERVICE","TELEGRAM"]
REACHABILITY_POINTS=[{"name":"RU-10","host":"193.233.245.212"},{"name":"TW2","host":"141.133.187.45"}]
REACHABILITY_SSH_KEY_PATH=/run/secrets/probe_key
REACHABILITY_SSH_KNOWN_HOSTS_PATH=/run/secrets/probe_known_hosts
REACHABILITY_SSH_USER=root
